<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NHSE.Mac.App"
             Name="NHSE"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://NHSE/Themes.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <!-- Items of the application menu ("NHSE" in the menu bar), before Hide/Quit. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About NHSE" Click="About_Click" />
            <NativeMenuItem Header="Check for Updates…" Click="CheckUpdates_Click" />
        </NativeMenu>
    </NativeMenu.Menu>
    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <StyleInclude Source="avares://NHSE/Styles.axaml" />
    </Application.Styles>
</Application>
