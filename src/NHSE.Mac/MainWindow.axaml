<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NHSE.Mac.MainWindow"
        Title="NHSE"
        Width="520" Height="440"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.png">
    <Window.Styles>
        <Style Selector="Rectangle#DropZone">
            <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        </Style>
        <Style Selector="Rectangle#DropZone.over">
            <Setter Property="Stroke" Value="DodgerBlue" />
            <Setter Property="Fill" Value="#181E90FF" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="24,20,24,18">
        <StackPanel Orientation="Horizontal" Spacing="14">
            <Image Source="/Assets/icon.png" Width="56" Height="56" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="NHSE" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Animal Crossing: New Horizons Save Editor" Classes="hint" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <Panel Grid.Row="1" Margin="0,18,0,14">
            <Rectangle Name="DropZone" RadiusX="12" RadiusY="12" StrokeThickness="2" StrokeDashArray="5,3" Fill="#0C808080" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="24">
                <TextBlock Text="⤓" FontSize="34" HorizontalAlignment="Center" Classes="hint" />
                <TextBlock Name="L_Drop" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Name="L_DropHint" Classes="hint" TextAlignment="Center" MaxWidth="380" />
            </StackPanel>
        </Panel>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Center">
            <Button Name="B_OpenFolder" Classes="accent" Margin="4" Click="B_OpenFolder_Click" />
            <Button Name="B_OpenFile" Margin="4" Click="B_OpenFile_Click" />
            <Button Name="B_Reopen" Margin="4" Click="B_Reopen_Click" />
            <Button Name="B_OpenLive" Margin="4" Click="B_OpenLive_Click" />
        </WrapPanel>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <TextBlock Name="L_Warning" Classes="hint" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                <Button Name="B_Images" Click="B_Images_Click" />
                <Button Name="B_Backups" Click="B_Backups_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
