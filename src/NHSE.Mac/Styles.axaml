<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared look for the ported WinForms layouts: compact rows, labels aligned with their editors. -->
    <Style Selector="TextBlock.label">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="FormatString" Value="0" />
        <Setter Property="ShowButtonSpinner" Value="True" />
    </Style>
    <Style Selector="Button">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Like WinForms buttons, long captions wrap when the button has a fixed width. -->
    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="ClipValueToMinMax" Value="True" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Border.slot">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Home window -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource NhCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NhCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource NhSubtleBrush}" />
        <Setter Property="Margin" Value="4,18,0,8" />
    </Style>
    <Style Selector="TextBlock.cardtitle">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.subtle">
        <Setter Property="Foreground" Value="{DynamicResource NhSubtleBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.amount">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.titlebox">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBox.titlebox:pointerover /template/ Border#PART_BorderElement, TextBox.titlebox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource NhSidebarBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.nav">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NhSelectedBrush}" />
    </Style>
    <Style Selector="Button.card">
        <Setter Property="Background" Value="{DynamicResource NhCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NhCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.card /template/ ContentPresenter">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NhSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NhGreenBrush}" />
    </Style>
    <Style Selector="Image.icon">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
</Styles>
