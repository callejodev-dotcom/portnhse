<nh:NhseWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nh="using:NHSE.Mac"
        x:Class="NHSE.Mac.VillagerHouseEditor"
        Title="Villager House Editor"
        Width="560" Height="420" MinWidth="460" MinHeight="260">
    <Grid ColumnDefinitions="170,*" RowDefinitions="*,Auto" Margin="12">
        <ListBox Name="LB_Items" Grid.RowSpan="2" SelectionChanged="LB_Items_SelectedIndexChanged" />
        <nh:PropertyGrid Name="PG_Item" Grid.Column="1" Margin="8,0,0,0" PropertySort="NoSort" HelpVisible="False"
                         PropertyValueChanged="PG_Item_PropertyValueChanged" />
        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="8,10,0,0">
            <Button Name="B_DumpHouse" Content="Dump" Width="80" Click="B_DumpHouse_Click" />
            <Button Name="B_LoadHouse" Grid.Column="1" Content="Load" Width="80" Margin="6,0,0,0" Click="B_LoadHouse_Click" />
            <Button Name="B_Cancel" Grid.Column="3" Content="Cancel" Width="80" IsCancel="True" Click="B_Cancel_Click" />
            <Button Name="B_Save" Grid.Column="4" Content="Save" Width="80" Margin="6,0,0,0" Classes="accent" Click="B_Save_Click" />
        </Grid>
    </Grid>
</nh:NhseWindow>
