<nh:NhseWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nh="using:NHSE.Mac"
        x:Class="NHSE.Mac.SaveRoomFloorWallEditor"
        Title="Room Editor"
        SizeToContent="WidthAndHeight" CanResize="False">
    <nh:NhseWindow.Styles>
        <Style Selector="Grid#TLP_Room > Button">
            <Setter Property="Width" Value="116" />
            <Setter Property="Height" Value="44" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="Grid#TLP_Room > StackPanel">
            <Setter Property="Spacing" Value="2" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </nh:NhseWindow.Styles>

    <StackPanel Margin="16" Spacing="18">
        <Grid Name="TLP_Room" ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <Button Name="B_AccentWall" Content="Accent Wall" Click="B_AccentWall_Click" />
            <StackPanel Grid.Column="1">
                <TextBlock Name="L_AccentDesign" Text="DesignID" />
                <NumericUpDown Name="NUD_DesignAccent" Maximum="65535" Width="100" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Name="L_AccentDirection" Text="Direction" />
                <NumericUpDown Name="NUD_DirAccent" Maximum="255" Width="80" />
            </StackPanel>

            <Button Name="B_Wall" Grid.Row="1" Content="Wall" Click="B_Wall_Click" />
            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Name="L_WallDesign" Text="DesignID" />
                <NumericUpDown Name="NUD_DesignWall" Maximum="65535" Width="100" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Name="L_InfoBit" Text="InfoBit" />
                <NumericUpDown Name="NUD_InfoBit" Maximum="255" Width="80" />
            </StackPanel>

            <Button Name="B_Floor" Grid.Row="2" Content="Floor" Click="B_Floor_Click" />
            <StackPanel Grid.Row="2" Grid.Column="1">
                <TextBlock Name="L_FloorDesign" Text="DesignID" />
                <NumericUpDown Name="NUD_DesignFloor" Maximum="65535" Width="100" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Name="L_FloorDirection" Text="Direction" />
                <NumericUpDown Name="NUD_DirFloor" Maximum="255" Width="80" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
            <Button Name="B_Cancel" Content="Cancel" Width="80" IsCancel="True" Click="B_Cancel_Click" />
            <Button Name="B_Save" Content="Save" Width="80" Classes="accent" Click="B_Save_Click" />
        </StackPanel>
    </StackPanel>
</nh:NhseWindow>
