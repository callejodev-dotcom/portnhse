<nh:NhseWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nh="using:NHSE.Mac"
        x:Class="NHSE.Mac.RecipeListEditor"
        Title="Recipe List Editor"
        Width="500" Height="460" MinWidth="420" MinHeight="360">
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto" Margin="12">
        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <TextBlock Name="L_Goto" Text="goto:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Name="CB_Goto" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch" MaxDropDownHeight="400"
                      SelectionChanged="CB_Goto_SelectedValueChanged" />
        </Grid>

        <ListBox Name="LB_Recipes" Grid.Row="1" FontFamily="Menlo" FontSize="12" SelectionChanged="LB_Recipes_SelectedIndexChanged" />

        <DockPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Width="120">
            <StackPanel DockPanel.Dock="Top" Spacing="2">
                <CheckBox Name="CHK_Known" Content="Known" IsCheckedChanged="CHK_Known_CheckedChanged" />
                <CheckBox Name="CHK_Made" Content="Crafted" />
                <CheckBox Name="CHK_Favorite" Content="Favorite" />
                <CheckBox Name="CHK_New" Content="New" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Spacing="6">
                <StackPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </Style>
                </StackPanel.Styles>
                <Button Name="B_All" Content="Learn All" Click="B_All_Click" />
                <Button Name="B_CraftAll" Content="Craft All" Click="B_CraftAll_Click" />
                <Button Name="B_ClearAll" Content="Clear All" Margin="0,12,0,0" Click="B_ClearAll_Click" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,12,0,0">
            <Button Name="B_Cancel" Content="Cancel" Width="80" IsCancel="True" Click="B_Cancel_Click" />
            <Button Name="B_Save" Content="Save" Width="80" Classes="accent" Click="B_Save_Click" />
        </StackPanel>
    </Grid>
</nh:NhseWindow>
