<nh:NhseWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nh="using:NHSE.Mac"
        x:Class="NHSE.Mac.ItemReceivedEditor"
        Title="Received Item List Editor"
        Width="980" Height="560" MinWidth="760" MinHeight="400">
    <nh:NhseWindow.Styles>
        <Style Selector="ListBox.checked">
            <Setter Property="FontFamily" Value="Menlo" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ListBox.checked ListBoxItem">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </nh:NhseWindow.Styles>

    <Grid ColumnDefinitions="410,*" RowDefinitions="Auto,*,Auto,Auto" Margin="12">
        <TextBlock Name="L_Received" Text="Received" Margin="0,0,0,4" />
        <TextBlock Name="L_VariantBody" Grid.Column="1" Text="Variant Body" Margin="12,0,0,4" />

        <ListBox Name="CLB_Items" Grid.Row="1" Classes="checked" SelectionChanged="CLB_Items_SelectedIndexChanged" />
        <ListBox Name="CLB_Remake" Grid.Row="1" Grid.Column="1" Classes="checked" Margin="12,0,0,0" />

        <ComboBox Name="CB_Item" Grid.Row="2" IsEditable="True" HorizontalAlignment="Stretch" MaxDropDownHeight="400" Margin="0,8,0,0"
                  SelectionChanged="CB_Item_SelectedValueChanged" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
            <Button Name="B_GiveAll" Content="Give All" Width="110">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuItem Name="B_AllFish" Header="Give All Fish" Click="B_AllFish_Click" />
                        <MenuItem Name="B_AllBugs" Header="Give All Bugs" Click="B_AllBugs_Click" />
                        <MenuItem Name="B_AllDive" Header="Give All Dive" Click="B_AllDive_Click" />
                        <MenuItem Name="B_AllArt" Header="Give All Art" Click="B_AllArt_Click" />
                        <MenuItem Name="B_AllFurniture" Header="Give All Furniture + Clothing" Click="B_AllFurniture_Click" />
                        <MenuItem Name="B_GiveEverything" Header="Everything" Click="B_GiveEverything_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <CheckBox Name="CB_VariantBodiesOnly" Content="Give Variant Bodies Only" />
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="6">
            <Button Name="B_Cancel" Content="Cancel" Width="96" IsCancel="True" Click="B_Cancel_Click" />
            <Button Name="B_Save" Content="Save" Width="96" Classes="accent" Click="B_Save_Click" />
        </StackPanel>
    </Grid>
</nh:NhseWindow>
