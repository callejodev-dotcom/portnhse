<nh:NhseWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nh="using:NHSE.Mac"
        x:Class="NHSE.Mac.ReactionEditor"
        Title="Reaction List Editor"
        Width="400" Height="440" MinWidth="340" MinHeight="300">
    <Grid RowDefinitions="*,Auto" Margin="12">
        <nh:PropertyGrid Name="PG_Manpu" PropertySort="NoSort" HelpVisible="False" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
            <Button Name="B_GiveAll" Content="Give All" Width="96" Click="B_GiveAll_Click" />
            <Button Name="B_Cancel" Grid.Column="2" Content="Cancel" Width="80" IsCancel="True" Click="B_Cancel_Click" />
            <Button Name="B_Save" Grid.Column="3" Content="Save" Width="80" Margin="6,0,0,0" Classes="accent" Click="B_Save_Click" />
        </Grid>
    </Grid>
</nh:NhseWindow>
